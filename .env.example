DB_ROOT_PASS=change_me_root
DB_NAME=maritime_duty
DB_USER=maritime_user
DB_PASS=change_me_user

# ── 中央氣象署（CWA）開放資料 API 金鑰 ──────────────────────────────────────
# 提供「即時海況」資料來源（浮標站海氣象觀測，資料集 M-A0064-001）。
#
#   留空        → 系統自動以台灣海域季節波高統計生成模擬海象（data_source=synthetic），
#                  介面會誠實標記為「季節模擬」，demo 仍可完整展示。
#   填入金鑰    → fetch_sea_data.py 改抓真實 CWA 浮標觀測（data_source=cwa_api）。
#
# 免費申請（約 1 分鐘）：
#   1. 至 https://opendata.cwa.gov.tw/user/api/info 註冊並取得授權碼（CWA-xxxxxxxx 格式）
#   2. 貼到下方 CWA_API_KEY=
#   3. docker compose run --rm analysis python fetch_sea_data.py  重新抓取
#
# ⚠️ 金鑰屬機密，.env 已列入 .gitignore，請勿 commit。
CWA_API_KEY=
